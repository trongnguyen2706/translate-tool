{
  "name": "phrasebook-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "build:extension": "node scripts/build_extension.mjs",
    "test:extension-ui": "node tests/extension-ui-server.mjs",
    "check:extension": "node --check extension/src/content.js && node --check extension/src/background.mjs && node --check extension/src/storage.mjs && node --check extension/src/dictionary-core.mjs && node --check extension/src/popup.mjs && node --check extension/src/options.mjs && node --check extension/src/manage.mjs && node tests/extension-core.test.mjs && node tests/extension-network.test.mjs && node tests/extension-install.test.mjs && node tests/extension-upgrade.test.mjs && npm run build:extension",
    "test:dictionaries": "python -m unittest discover -s tests -p \"test_*.py\"",
    "test:dictionary-language": "node tests/dictionary-language.test.mjs",
    "test:database": "node tests/database.test.mjs",
    "test:backup": "node tests/backup.test.mjs && node tests/backup-roundtrip.test.mjs",
    "package:extension": "npm run check:extension && node scripts/package_extension.mjs",
    "test:staging-load": "node scripts/staging_load.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.1",
    "fflate": "0.8.3",
    "lucide-react": "^0.475.0",
    "next": "^16.3.6",
    "openai": "^7.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.6",
    "fake-indexeddb": "^6.2.6",
    "typescript": "^5.9.3"
  }
}
